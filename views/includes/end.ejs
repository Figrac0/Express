<!-- views/includes/end.ejs -->
<footer class="site-footer">
    <div class="footer-shell">
        <div class="footer-col footer-col--brand">
            <div class="brand">
                <span class="brand__mark"></span>
                <span class="brand__name">Express Shop</span>
            </div>
            <p class="footer-description">
                Premium e-commerce experience built with Express, MongoDB and Stripe.
                Clean architecture. Secure payments. Fast performance.
            </p>
            <div class="footer-badges">
                <span class="footer-badge">Secure Payments</span>
                <span class="footer-badge">Stripe</span>
                <span class="footer-badge">MongoDB</span>
            </div>
        </div>

        <div class="footer-col">
            <h4 class="footer-title">Navigation</h4>
            <ul class="footer-links">
                <li><a href="/">Shop</a></li>
                <li><a href="/products">Products</a></li>
                <% if (isAuthenticated) { %>
                    <li><a href="/cart">Cart</a></li>
                    <li><a href="/orders">Orders</a></li>
                <% } else { %>
                    <li><a href="/login">Login</a></li>
                    <li><a href="/signup">Signup</a></li>
                <% } %>
            </ul>
        </div>

        <div class="footer-col">
            <h4 class="footer-title">Account</h4>
            <ul class="footer-links">
                <% if (isAuthenticated) { %>
                    <li><a href="/admin/add-product">Add Product</a></li>
                    <li><a href="/admin/products">Admin Products</a></li>
                    <li>
                        <form action="/logout" method="post" style="display:inline;">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button class="footer-link-btn" type="submit">Logout</button>
                        </form>
                    </li>
                <% } else { %>
                    <li><a href="/login">Sign In</a></li>
                    <li><a href="/signup">Create Account</a></li>
                <% } %>
            </ul>
        </div>

        <div class="footer-col">
            <h4 class="footer-title">Legal</h4>
            <ul class="footer-links">
                <li><a href="#">Terms</a></li>
                <li><a href="#">Privacy</a></li>
                <li><a href="#">Refund Policy</a></li>
            </ul>
        </div>
    </div>

    <div class="footer-bottom">
        <div class="footer-bottom-inner">
            <span>© <%= new Date().getFullYear() %> Express Shop. All rights reserved.</span>
            <span class="footer-dev">Built with Express · EJS · Stripe</span>
        </div>
    </div>
</footer>

<script src="/js/main.js"></script>
</body>
</html>