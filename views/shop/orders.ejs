<!-- views/shop/orders.ejs -->
<%- include('../includes/head.ejs') %>
<link rel="stylesheet" href="/css/orders.css">
</head>

<body>
    <%- include('../includes/navigation.ejs') %>

    <main>
        <section class="page-hero">
            <div>
                <h1>Your Orders</h1>
                <p>Download invoices and review purchases</p>
            </div>
        </section>

        <% if (orders.length <= 0) { %>
            <section class="page-hero">
                <div>
                    <h1>No orders yet</h1>
                    <p>Checkout to create your first order</p>
                </div>
                <a class="btn" href="/products">Browse</a>
            </section>
        <% } else { %>
            <ul class="orders">
                <% orders.forEach(order => { %>
                    <li class="orders__item">
                        <h1>
                            Order – # <%= order._id %> –
                            <a href="/orders/<%= order._id %>">Invoice</a>
                        </h1>
                        <ul class="orders__products">
                            <% order.products.forEach(p => { %>
                                <li class="orders__products-item"><%= p.product.title %> (<%= p.quantity %>)</li>
                            <% }); %>
                        </ul>
                    </li>
                <% }); %>
            </ul>
        <% } %>
    </main>

    <%- include('../includes/end.ejs') %>